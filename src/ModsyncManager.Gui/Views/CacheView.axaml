<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Modsync.Gui.Shared.ViewModels"
             x:Class="ModsyncManager.Gui.Views.CacheView"
             x:DataType="vm:CacheVM">

    <Grid RowDefinitions="Auto,*" Margin="20">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,16">
            <TextBlock Grid.Column="0"
                       Text="{Tr 'Cache.Title'}"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">

                <!-- Hash cache -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Tr 'Cache.HashCache_SectionTitle'}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="12">

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding HashCachePath}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontFamily="Consolas,Menlo,monospace"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding HashCacheSizeText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{Tr 'Cache.HashCache_Clear_Button'}"
                                        Command="{Binding ClearHashCacheCommand}"
                                        Padding="12,6" />
                            </Grid>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontSize="12"
                                       IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <TextBlock Text="{Tr 'Cache.HashCache_Description'}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

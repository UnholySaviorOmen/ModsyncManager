<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Modsync.Gui.Shared.ViewModels"
             xmlns:controls="using:Modsync.Gui.Controls.Views"
             x:Class="ModsyncManager.Gui.Views.LogsView"
             x:DataType="vm:LogsVM">

    <Grid RowDefinitions="Auto,*" Margin="20">

        <!-- Header + toolbar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,16">

            <TextBlock Grid.Column="0"
                       Text="{Tr 'Logs.Title'}"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="{Tr 'Logs.OpenFolder_Button'}"
                    Command="{Binding OpenLogsFolderCommand}"
                    Padding="12,6"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- LogView -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <controls:LogView DataContext="{Binding Log}" />
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Modsync.Gui.Shared.ViewModels"
             x:Class="ModsyncManager.Gui.Views.SettingsView"
             x:DataType="vm:SettingsVM">

    <Grid RowDefinitions="Auto,*" Margin="20">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,16">
            <TextBlock Grid.Column="0"
                       Text="{Tr 'Settings.Title'}"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">

                <!-- Nexus Mods (API key) -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Tr 'Nexus.SectionTitle'}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="12">

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Nexus.StatusText}"
                                           Foreground="{Binding Nexus.StatusColor}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Content="{Tr 'Nexus.Recheck_Button'}"
                                            Command="{Binding Nexus.RevalidateCommand}"
                                            IsVisible="{Binding Nexus.HasSavedKey}"
                                            Padding="12,6" />
                                    <Button Content="{Tr 'Nexus.Logout_Button'}"
                                            Command="{Binding Nexus.LogoutCommand}"
                                            IsVisible="{Binding Nexus.HasSavedKey}"
                                            Padding="12,6" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding Nexus.KeyFilePath}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="Consolas,Menlo,monospace"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />

                            <Border Background="{StaticResource SurfaceBaseBrush}"
                                    BorderBrush="{StaticResource ErrorBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    IsVisible="{Binding Nexus.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding Nexus.ErrorMessage}"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Grid ColumnDefinitions="*,Auto"
                                  IsVisible="{Binding !Nexus.IsLoggedIn}">
                                <TextBox Grid.Column="0"
                                         Text="{Binding Nexus.ApiKeyInput}"
                                         PasswordChar="•"
                                         Watermark="{Tr 'Nexus.ApiKey_Watermark'}"
                                         Margin="0,0,8,0" />

                                <Button Grid.Column="1"
                                        Content="{Tr 'Nexus.SaveAndValidate_Button'}"
                                        Command="{Binding Nexus.SaveAndValidateCommand}"
                                        Padding="16,8" />
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <Button Content="{Tr 'Nexus.OpenApiPage_Button'}"
                                        Command="{Binding Nexus.OpenNexusApiPageCommand}"
                                        Padding="12,6" />
                                <TextBlock Text="{Tr 'Nexus.OpenApiPage_Hint'}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Nexus Free Download -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Tr 'NexusFree.SectionTitle'}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="12">

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding NexusFreeDownload.StatusText}"
                                           Foreground="{Binding NexusFreeDownload.StatusColor}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Content="{Tr 'NexusFree.Enable_Button'}"
                                            Command="{Binding NexusFreeDownload.RegisterCommand}"
                                            IsVisible="{Binding !NexusFreeDownload.IsRegisteredToUs}"
                                            IsEnabled="{Binding !NexusFreeDownload.IsBusy}"
                                            Padding="12,6" />
                                    <Button Content="{Tr 'NexusFree.Restore_Button'}"
                                            Command="{Binding NexusFreeDownload.RestoreCommand}"
                                            IsEnabled="{Binding !NexusFreeDownload.IsBusy}"
                                            Padding="12,6" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding NexusFreeDownload.HandlerPath}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="Consolas,Menlo,monospace"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />

                            <Border Background="{StaticResource SurfaceBaseBrush}"
                                    BorderBrush="{StaticResource ErrorBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    IsVisible="{Binding NexusFreeDownload.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding NexusFreeDownload.ErrorMessage}"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Tr 'NexusFree.Description'}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Language -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Tr 'Settings.Language_SectionTitle'}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="8">

                            <TextBlock Text="{Tr 'Settings.Language_Label'}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" />

                            <ComboBox ItemsSource="{Binding AvailableCultures}"
                                      SelectedItem="{Binding SelectedCulture}"
                                      HorizontalAlignment="Stretch" />

                            <TextBlock Text="{Binding LanguageChangedHint}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Application settings -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Tr 'Settings.AppSettings_Title'}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="12">

                            <CheckBox Content="{Tr 'Settings.AppSettings_DevMode'}"
                                      IsChecked="{Binding IsDevMode}" />

                            <TextBlock Text="{Tr 'Settings.AppSettings_DevMode_Description'}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

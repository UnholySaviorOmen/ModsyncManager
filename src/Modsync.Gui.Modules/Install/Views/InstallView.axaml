<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Modsync.Gui.Modules.Install.ViewModels"
             xmlns:controls="using:Modsync.Gui.Controls.Views"
             x:Class="Modsync.Gui.Modules.Install.Views.InstallView"
             x:DataType="vm:InstallVM">

    <UserControl.Styles>
        <Style Selector="PathIcon.spinner">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="RenderTransform">
                <RotateTransform CenterX="7" CenterY="7" />
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="20">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0"
                       Text="{Tr 'Install.Title'}"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Configuration -->
        <StackPanel Grid.Row="1"
                    Spacing="16"
                    IsVisible="{Binding IsConfiguring}"
                    VerticalAlignment="Top">
            <controls:FilePickerView DataContext="{Binding ModlistPicker}" />
            <controls:FilePickerView DataContext="{Binding TargetPicker}" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource WarningBrush}"
                       FontSize="12"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Button Content="{Tr 'Install.Install_Button'}"
                    Command="{Binding InstallCommand}"
                    HorizontalAlignment="Left"
                    Padding="20,8" />
        </StackPanel>

        <!-- Installing -->
        <StackPanel Grid.Row="1"
                    Spacing="20"
                    IsVisible="{Binding IsInstalling}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">

            <TextBlock Text="{Binding StepName}"
                       FontSize="16"
                       HorizontalAlignment="Center" />

            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center">

                <TextBlock Text="{Binding StepLabel}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />

                <TextBlock Text="·"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasDetail}" />

                <TextBlock Text="{Binding Detail}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasDetail}" />

                <PathIcon Classes="spinner"
                          IsVisible="{Binding HasDetail}">
                    <PathIcon.Data>
                        <StreamGeometry>M 12 3 A 9 9 0 1 1 3 12</StreamGeometry>
                    </PathIcon.Data>
                </PathIcon>
            </StackPanel>

            <ProgressBar Value="{Binding Percent}"
                         Minimum="0"
                         Maximum="100"
                         Height="6" />

            <Button Content="{Tr 'Install.Cancel_Button'}"
                    Command="{Binding CancelCommand}"
                    HorizontalAlignment="Center"
                    Padding="20,8" />
        </StackPanel>

        <!-- Success -->
        <StackPanel Grid.Row="1"
                    Spacing="12"
                    IsVisible="{Binding IsSuccess}"
                    VerticalAlignment="Top">
            <TextBlock Text="{Tr 'Install.Success_Title'}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SuccessBrush}" />

            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Tr 'Install.Summary_Name'}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding Summary.Name}" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Tr 'Install.Summary_Version'}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding Summary.Version}" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Tr 'Install.Summary_Instance'}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding Summary.InstancePath}"
                               FontFamily="Consolas,Menlo,monospace"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,4" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Tr 'Install.Summary_Mods'}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding ModsSummaryText}" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Tr 'Install.Summary_Archives'}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="4" Grid.Column="1"
                               Text="{Binding ArchivesSummaryText}" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{Tr 'Install.Summary_MetaIni'}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="5" Grid.Column="1"
                               Text="{Binding Summary.MetaIniWritten}"
                               Margin="0,0,0,4" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{Tr 'Install.Summary_ArchiveMeta'}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />
                    <TextBlock Grid.Row="6" Grid.Column="1"
                               Text="{Binding Summary.ArchiveMetaWritten}" />
                </Grid>
            </Border>

            <Button Content="{Tr 'Install.Done_Button'}"
                    Command="{Binding DoneCommand}"
                    HorizontalAlignment="Left"
                    Padding="20,8" />
        </StackPanel>

        <!-- Failure -->
        <StackPanel Grid.Row="1"
                    Spacing="12"
                    IsVisible="{Binding IsFailure}"
                    VerticalAlignment="Top">
            <TextBlock Text="{Tr 'Install.Failure_Title'}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ErrorBrush}" />

            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource ErrorBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas,Menlo,monospace"
                           FontSize="12" />
            </Border>

            <Button Content="{Tr 'Install.Done_Button'}"
                    Command="{Binding DoneCommand}"
                    HorizontalAlignment="Left"
                    Padding="20,8" />
        </StackPanel>

    </Grid>
</UserControl>

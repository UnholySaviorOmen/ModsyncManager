<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Modsync.Gui.Modules.Pack.ViewModels"
             xmlns:controls="using:Modsync.Gui.Controls.Views"
             x:Class="Modsync.Gui.Modules.Pack.Views.PackView"
             x:DataType="vm:PackVM">

    <UserControl.Styles>
        <!-- Спиннер: дуга, вращающаяся вокруг центра.
             PathIcon 24x24 viewBox, Path строится через SVG-подобный синтаксис.
             RotateTransform.Angle анимируется 0 → 360 за 1 секунду. -->
        <Style Selector="PathIcon.spinner">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="RenderTransform">
                <RotateTransform CenterX="7" CenterY="7" />
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="20">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0"
                       Text="Pack"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Configuration -->
        <StackPanel Grid.Row="1"
                    Spacing="16"
                    IsVisible="{Binding IsConfiguring}"
                    VerticalAlignment="Top">

            <TextBlock Text="Start a pack"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />

            <Button Content="Load config…"
                    Command="{Binding LoadConfigCommand}"
                    HorizontalAlignment="Left"
                    Padding="20,8" />
            <TextBlock Text="Open an existing modsyncmanager-pack.json to edit and pack."
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11"
                       Margin="0,-8,0,0" />

            <Button Content="Create config…"
                    Command="{Binding CreateConfigCommand}"
                    HorizontalAlignment="Left"
                    Padding="20,8"
                    Margin="0,8,0,0" />
            <TextBlock Text="Start from scratch. Recommended if you've never packed this instance before."
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11"
                       Margin="0,-8,0,0" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource WarningBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        
        <!-- Config form (embedded, replaces Configuration) -->
        <ContentControl Grid.Row="1"
                        Content="{Binding ConfigVM}"
                        IsVisible="{Binding IsCreatingConfig}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

        <!-- Packing -->
        <StackPanel Grid.Row="1"
                    Spacing="20"
                    IsVisible="{Binding IsPacking}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding StepName}"
                       FontSize="16"
                       HorizontalAlignment="Center" />

            <!-- Step X of Y · Detail ⟳ -->
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center">

                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center">
                    <Run Text="Step " />
                    <Run Text="{Binding CurrentStep}" />
                    <Run Text=" of " />
                    <Run Text="{Binding TotalSteps}" />
                </TextBlock>

                <TextBlock Text="·"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasDetail}" />

                <TextBlock Text="{Binding Detail}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasDetail}" />

                <PathIcon Classes="spinner"
                          IsVisible="{Binding HasDetail}">
                    <PathIcon.Data>
                        <StreamGeometry>M 12 3 A 9 9 0 1 1 3 12</StreamGeometry>
                    </PathIcon.Data>
                </PathIcon>
            </StackPanel>

            <ProgressBar Value="{Binding Percent}"
                         Minimum="0"
                         Maximum="100"
                         Height="6" />

            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    HorizontalAlignment="Center"
                    Padding="20,8" />
        </StackPanel>

        <!-- Success -->
        <StackPanel Grid.Row="1"
                    Spacing="12"
                    IsVisible="{Binding IsSuccess}"
                    VerticalAlignment="Top">
            <TextBlock Text="Pack complete"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SuccessBrush}" />

            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding Summary.Name}" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Version"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding Summary.Version}" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Instance"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding Summary.InstancePath}"
                               FontFamily="Consolas,Menlo,monospace"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,4" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Mods scanned"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,4">
                        <Run Text="{Binding Summary.ModsScanned}" />
                        <Run Text=" mods, " />
                        <Run Text="{Binding Summary.FilesScanned}" />
                        <Run Text=" files" />
                    </TextBlock>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Directives"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,4">
                        <Run Text="{Binding Summary.DirectivesTotal}" />
                        <Run Text=" total, " />
                        <Run Text="{Binding Summary.DirectivesFromArchive}" />
                        <Run Text=" from archive" />
                    </TextBlock>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Archives"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,0,0,4">
                        <Run Text="{Binding Summary.ArchivesResolved}" />
                        <Run Text=" resolved, " />
                        <Run Text="{Binding Summary.ArchivesUnresolved}" />
                        <Run Text=" unresolved" />
                    </TextBlock>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Unmatched"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="6" Grid.Column="1"
                               Text="{Binding Summary.UnmatchedFiles}"
                               Margin="0,0,0,4" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Manifest"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,0,0,4">
                        <Run Text="{Binding Summary.ManifestMods}" />
                        <Run Text=" mods, " />
                        <Run Text="{Binding Summary.ManifestArchives}" />
                        <Run Text=" archives, " />
                        <Run Text="{Binding Summary.ManifestExtensions}" />
                        <Run Text=" extensions, " />
                        <Run Text="{Binding Summary.ManifestExtras}" />
                        <Run Text=" extras" />
                    </TextBlock>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="meta.ini"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4" />
                    <TextBlock Grid.Row="8" Grid.Column="1"
                               Text="{Binding Summary.MetaIniCount}"
                               Margin="0,0,0,4" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Written to"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,4"
                               IsVisible="{Binding Summary.UnmatchedWrittenTo, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Grid.Row="9" Grid.Column="1"
                               Text="{Binding Summary.UnmatchedWrittenTo}"
                               FontFamily="Consolas,Menlo,monospace"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,4"
                               IsVisible="{Binding Summary.UnmatchedWrittenTo, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Manifest path"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />
                    <TextBlock Grid.Row="10" Grid.Column="1"
                               Text="{Binding Summary.ManifestPath}"
                               FontFamily="Consolas,Menlo,monospace"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Button Content="Done"
                    Command="{Binding DoneCommand}"
                    HorizontalAlignment="Left"
                    Padding="20,8" />
        </StackPanel>

        <!-- Failure -->
        <StackPanel Grid.Row="1"
                    Spacing="12"
                    IsVisible="{Binding IsFailure}"
                    VerticalAlignment="Top">
            <TextBlock Text="Pack failed"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ErrorBrush}" />

            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource ErrorBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas,Menlo,monospace"
                           FontSize="12" />
            </Border>

            <Button Content="Done"
                    Command="{Binding DoneCommand}"
                    HorizontalAlignment="Left"
                    Padding="20,8" />
        </StackPanel>

    </Grid>
</UserControl>

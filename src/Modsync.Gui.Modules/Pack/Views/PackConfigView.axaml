<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Modsync.Gui.Modules.Pack.ViewModels"
             x:Class="Modsync.Gui.Modules.Pack.Views.PackConfigView"
             x:DataType="vm:PackConfigVM">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0"
                       Text="{Tr 'Pack.Config.Title'}"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1"
                        Spacing="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="{Tr 'Pack.Config.LoadConfig_Button'}"
                        Command="{Binding LoadConfigFileCommand}"
                        Padding="16,8"
                        HorizontalAlignment="Right" />
                <TextBlock Text="{Tr 'Pack.Config.LoadConfig_Hint'}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">

                <!-- Loaded from -->
                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Consolas,Menlo,monospace"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding HasLoadedFrom}">
                    <Run Text="{Tr 'Pack.Config.Footer_LoadedFrom'}" />
                    <Run Text=" " />
                    <Run Text="{Binding LoadedFromPath}" />
                </TextBlock>

                <!-- Instance -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Tr 'Pack.Config.Instance_SectionTitle'}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Tr 'Pack.Config.Instance_Folder_Label'}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding InstancePath}"
                                         Watermark="{Tr 'Pack.Config.Instance_Folder_Watermark'}"
                                         IsReadOnly="True"
                                         Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Content="{Tr 'Pack.Config.Instance_Browse_Button'}"
                                        Command="{Binding BrowseInstanceCommand}"
                                        Padding="14,8" />
                            </Grid>

                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource ErrorBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <TextBlock Text="{Tr 'Pack.Config.Instance_Scanning'}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       IsVisible="{Binding IsScanning}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Metadata -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Tr 'Pack.Config.Metadata_SectionTitle'}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="10">

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Tr 'Pack.Config.Metadata_Name_Label'}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" />
                                <TextBox Text="{Binding MetaName}"
                                         Watermark="{Tr 'Pack.Config.Metadata_Name_Watermark'}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Tr 'Pack.Config.Metadata_Version_Label'}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" />
                                <TextBox Text="{Binding MetaVersion}"
                                         Watermark="{Tr 'Pack.Config.Metadata_Version_Watermark'}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Tr 'Pack.Config.Metadata_Author_Label'}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" />
                                <TextBox Text="{Binding MetaAuthor}"
                                         Watermark="{Tr 'Pack.Config.Metadata_Author_Watermark'}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Tr 'Pack.Config.Metadata_Game_Label'}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" />
                                <TextBox Text="{Binding SelectedGame}"
                                         Watermark="{Tr 'Pack.Config.Metadata_Game_Watermark'}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Tr 'Pack.Config.Metadata_GameVersion_Label'}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" />
                                <TextBox Text="{Binding GameVersion}"
                                         Watermark="{Tr 'Pack.Config.Metadata_GameVersion_Watermark'}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Tr 'Pack.Config.Metadata_Profile_Label'}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" />
                                <ComboBox ItemsSource="{Binding AvailableProfiles}"
                                          SelectedItem="{Binding SelectedProfile}"
                                          IsEnabled="{Binding HasProfiles}"
                                          HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding ProfileHint}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           IsVisible="{Binding !HasProfiles}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- MO2 archive -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Tr 'Pack.Config.Mo2Archive_SectionTitle'}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="8">

                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Mo2ArchiveDisplay}"
                                           FontWeight="SemiBold"
                                           FontFamily="Consolas,Menlo,monospace" />
                                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11">
                                    <Run Text="{Tr 'Pack.Config.Mo2Archive_VersionPrefix'}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding Mo2VersionDisplay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Mo2SizeDisplay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Tr 'Pack.Config.Mo2Archive_Url_Label'}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" />
                                <TextBox Text="{Binding Mo2UrlDisplay}"
                                         IsReadOnly="True" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Tr 'Pack.Config.Mo2Archive_Hash_Label'}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" />
                                <TextBox Text="{Binding Mo2HashDisplay}"
                                         IsReadOnly="True" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Extensions -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Tr 'Pack.Config.Extensions_SectionTitle'}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Tr 'Pack.Config.Extensions_Hint'}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" />

                            <ItemsControl ItemsSource="{Binding Extensions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:PathEntryVM">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Value}"
                                                     Watermark="{Tr 'Pack.Config.Extensions_Watermark'}"
                                                     Margin="0,0,8,0" />
                                            <Button Grid.Column="1"
                                                    Content="×"
                                                    Padding="12,6"
                                                    Command="{Binding RemoveCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="{Tr 'Pack.Config.Extensions_Add_Button'}"
                                    Command="{Binding AddExtensionCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="12,6" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Extras -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Tr 'Pack.Config.Extras_SectionTitle'}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Tr 'Pack.Config.Extras_Hint'}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" />

                            <ItemsControl ItemsSource="{Binding Extras}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:PathEntryVM">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Value}"
                                                     Watermark="{Tr 'Pack.Config.Extras_Watermark'}"
                                                     Margin="0,0,8,0" />
                                            <Button Grid.Column="1"
                                                    Content="×"
                                                    Padding="12,6"
                                                    Command="{Binding RemoveCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="{Tr 'Pack.Config.Extras_Add_Button'}"
                                    Command="{Binding AddExtraCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="12,6" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Archives without metadata -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding UnresolvedArchivesHeader}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <TextBlock Text="{Tr 'Pack.Config.Archives_Hint'}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               IsVisible="{Binding HasUnresolvedArchives}" />

                    <TextBlock Text="{Tr 'Pack.Config.Archives_None'}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               IsVisible="{Binding !HasUnresolvedArchives}" />

                    <ItemsControl ItemsSource="{Binding UnresolvedArchives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:UnresolvedArchiveRowVM">
                                <Border Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16"
                                        Margin="0,4"
                                        Opacity="{Binding BorderOpacity}">
                                    <StackPanel Spacing="10">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontWeight="SemiBold"
                                                           FontFamily="Consolas,Menlo,monospace" />
                                                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11">
                                                    <Run Text="{Binding SizeText}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding HashText}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding IsExcluded}" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="{Tr 'Pack.Config.Archives_Skip_Button'}"
                                                    Command="{Binding ToggleExcludeCommand}"
                                                    IsVisible="{Binding !IsExcluded}"
                                                    Padding="12,6"
                                                    VerticalAlignment="Top" />
                                            <Button Grid.Column="1"
                                                    Content="{Tr 'Pack.Config.Archives_Unskip_Button'}"
                                                    Command="{Binding ToggleExcludeCommand}"
                                                    IsVisible="{Binding IsExcluded}"
                                                    Padding="12,6"
                                                    VerticalAlignment="Top" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Sources}"
                                                      IsVisible="{Binding !IsExcluded}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:ArchiveSourceRowVM">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                                            <TextBlock Text="{Tr 'Pack.Config.Mo2Archive_Url_Label'}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="12" />
                                                            <TextBox Text="{Binding Url}"
                                                                     Watermark="{Tr 'Pack.Config.Archives_Url_Watermark'}" />
                                                            <TextBlock Text="{Tr 'Pack.Config.Mo2Archive_Hash_Label'}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="12"
                                                                       Margin="0,4,0,0" />
                                                            <TextBox Text="{Binding Hash}"
                                                                     Watermark="{Tr 'Pack.Config.Archives_Hash_Watermark'}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="×"
                                                                Padding="12,6"
                                                                VerticalAlignment="Top"
                                                                Command="{Binding RemoveCommand}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="{Tr 'Pack.Config.Archives_AddMirror_Button'}"
                                                Command="{Binding AddSourceCommand}"
                                                IsVisible="{Binding !IsExcluded}"
                                                HorizontalAlignment="Left"
                                                Padding="12,6" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">

            <!-- Save path / overwrite warning -->
            <StackPanel Spacing="2">
                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Consolas,Menlo,monospace"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding !HasLoadedFrom}">
                    <Run Text="{Tr 'Pack.Config.Footer_ConfigWillBeSavedTo'}" />
                    <Run Text=" " />
                    <Run Text="{Binding SavePathDisplay}" />
                </TextBlock>

                <TextBlock Foreground="{StaticResource WarningBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           IsVisible="{Binding OverwriteWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Run Text="⚠ " />
                    <Run Text="{Binding OverwriteWarning}" />
                </TextBlock>
            </StackPanel>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0"
                        Content="{Tr 'Pack.Config.Cancel_Button'}"
                        Command="{Binding CancelCommand}"
                        Padding="20,8"
                        VerticalAlignment="Center" />

                <StackPanel Grid.Column="2"
                            Spacing="2"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right">
                    <Button Content="{Tr 'Pack.Config.SaveAs_Button'}"
                            Command="{Binding SaveAsCommand}"
                            Padding="20,8"
                            HorizontalAlignment="Right" />
                    <TextBlock Text="{Tr 'Pack.Config.SaveAs_Hint'}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               HorizontalAlignment="Right" />
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Spacing="2"
                            HorizontalAlignment="Right">
                    <Button Content="{Tr 'Pack.Config.Pack_Button'}"
                            Command="{Binding PackCommand}"
                            Padding="20,8"
                            HorizontalAlignment="Right" />
                    <TextBlock Text="{Tr 'Pack.Config.Pack_Hint'}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
